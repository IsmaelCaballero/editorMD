# EditorConfig: misma configuración básica en cualquier editor (https://editorconfig.org)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4

[*.md]
# En Markdown dos espacios finales son un salto de línea
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf

# Fixtures de codificación: no tocar
[fixtures/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
