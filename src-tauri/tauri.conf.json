{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "editorMD",
  "version": "0.0.1",
  "identifier": "io.github.editormd",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "editorMD",
        "width": 1100,
        "height": 750,
        "resizable": true,
        "fullscreen": false,
        "label": "main",
        "minWidth": 640,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Editor Markdown WYSIWYG",
    "license": "MIT"
  }
}
