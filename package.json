{
  "name": "editormd",
  "private": true,
  "version": "0.0.1",
  "description": "Editor Markdown WYSIWYG ligero y multiplataforma (Tauri 2 + Svelte 5)",
  "license": "MIT",
  "author": "Ismael Caballero",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "docs:ts": "typedoc",
    "docs:rust": "cargo doc --no-deps --manifest-path src-tauri/Cargo.toml --target-dir src-tauri/target && node scripts/copy-rustdoc.mjs",
    "docs": "npm run docs:ts && npm run docs:rust",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^5.0.3",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1"
  }
}
